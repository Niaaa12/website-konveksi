// firestore.rules
// ─────────────────────────────────────────────────────────────────────────────
// SIM Konveksi Hijab "Nur Cahaya Collection"
// Security Rules Firestore — berbasis role pengguna
//
// CARA DEPLOY:
//   firebase deploy --only firestore:rules
//
// ROLE YANG ADA:
//   admin    — akses penuh ke semua koleksi
//   manajer  — baca semua, buat & edit WO, tidak bisa hapus
//   kepalaTimProduksi — baca semua, update progress WO sendiri, catat pemakaian bahan
//   kepalaGudang   — baca semua, kelola penerimaan & transaksi persediaan
//   picproduksi — lihat dashboard, baca WO, jadwal produksi, dan unit produksi, serta update progress WO sendiri
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ────────────────────────────────────────────────────────────────────────

    // Apakah user sudah login?
    function isSignedIn() {
      return request.auth != null;
    }

    // Ambil role dari Firestore (cached per request oleh Firebase)
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Apakah akun masih aktif?
    function isAktif() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.aktif == true;
    }

    // Pengecekan role (semua juga membutuhkan akun aktif)
    function isAdmin() {
      return isSignedIn() && isAktif() && getRole() == 'admin';
    }

    function isManajer() {
      return isSignedIn() && isAktif() && getRole() in ['admin', 'manajer'];
    }

    function isProduksi() {
      return isSignedIn() && isAktif() && getRole() in ['admin', 'manajer', 'kepalaTimProduksi'];
    }

    function isGudang() {
      return isSignedIn() && isAktif() && getRole() in ['admin', 'manajer', 'kepalaGudang'];
    }

    function isPICProduksi() {
      return isSignedIn() && isAktif() && getRole() in ['admin', 'manajer', 'picproduksi'];
    }

    function isAnyStaff() {
      return isSignedIn() && isAktif();
    }

    // Apakah user adalah pemilik dokumen (untuk profil sendiri)?
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ────────────────────────────────────────────────────────────────────────
    // USERS
    // Setiap user hanya bisa baca & edit profilnya sendiri.
    // Hanya admin yang bisa buat, hapus, dan baca semua user.
    // ────────────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────────
    // DATA REFERENSI (read-only untuk staf, admin yang mengelola)
    // Koleksi: materialCategories, productCategories, suppliers, productionUnits
    // ────────────────────────────────────────────────────────────────────────
    match /materialCategories/{docId} {
      allow read:             if isAnyStaff();
      allow create, update:   if isManajer();
      allow delete:           if isAdmin();
    }

    match /productCategories/{docId} {
      allow read:             if isAnyStaff();
      allow create, update:   if isManajer();
      allow delete:           if isAdmin();
    }

    match /suppliers/{docId} {
      allow read:             if isAnyStaff();
      allow create, update:   if isGudang();
      allow delete:           if isAdmin();
    }

    match /productionUnits/{docId} {
      allow read:             if isAnyStaff();
      allow create, update:   if isManajer();
      allow delete:           if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────────
    // PRODUCTS (+ subcollection variants dan bom)
    // Semua staf bisa baca. Manajer/admin yang bisa edit.
    // ────────────────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read:             if isAnyStaff();
      allow create, update:   if isManajer();
      allow delete:           if isAdmin();

      // Varian warna produk
      match /variants/{variantId} {
        allow read:           if isAnyStaff();
        allow create:         if isManajer();
        allow update:         if isAnyStaff();
        allow delete:         if isAdmin();
      }

      // Bill of Materials — resep produksi
      match /bom/{bomId} {
        allow read:           if isAnyStaff();
        allow create, update: if isManajer();
        allow delete:         if isAdmin();
      }
    }

    // ────────────────────────────────────────────────────────────────────────
    // MATERIALS (bahan baku)
    // Semua staf baca. Gudang & admin yang bisa tambah/edit.
    // ────────────────────────────────────────────────────────────────────────
    match /materials/{materialId} {
      allow read:             if isAnyStaff();
      allow create, update:   if isGudang();
      allow delete:           if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────────
    // WORK ORDERS (inti produksi)
    //
    // - Admin & manajer: akses penuh
    // - Staf produksi: baca semua WO, update HANYA jika dia operatornya
    //   dan hanya boleh mengubah field progress (jumlahSelesai, jumlahCacat, status)
    // - Gudang: baca saja (perlu tahu WO untuk catat pemakaian bahan)
    // ────────────────────────────────────────────────────────────────────────
    match /workOrders/{woId} {
      allow read:   if isAnyStaff();
      allow create: if isProduksi();
      allow delete: if isAdmin();

      // Update: manajer/admin/produksi bebas update semua field
      allow update: if isProduksi();

      // Tahap produksi — staf produksi & manajer bisa baca, create, dan update
      match /tahapProduksi/{tahapId} {
        allow read:   if isAnyStaff();
        allow create: if isProduksi();
        allow update: if isProduksi() || isPICProduksi();
        allow delete: if isAdmin();
      }

      // Progress logs — staf produksi HANYA bisa tambah (create), tidak bisa edit/hapus
      // Ini menjaga integritas audit trail
      match /progressLogs/{logId} {
        allow read:   if isAnyStaff();
        allow create: if isProduksi()
                      && request.resource.data.dicatatOleh == request.auth.uid;
        allow update: if isAdmin();  // hanya admin bisa koreksi log
        allow delete: if isAdmin();
      }

      // Pemakaian bahan dalam WO — staf produksi bisa catat, tidak bisa hapus
      match /materialUsage/{usageId} {
        allow read:   if isAnyStaff();
        allow create: if isProduksi()
                      && request.resource.data.dicatatOleh == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      // Hasil inspeksi QC — staf produksi & gudang bisa baca, hanya QC/manajer yang isi
      match /qcInspections/{qcId} {
        allow read:   if isAnyStaff();
        allow create: if isManajer()
                      && request.resource.data.inspektorId == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ────────────────────────────────────────────────────────────────────────
    // STOCK TRANSACTIONS (log perubahan stok — append only)
    // Dokumen yang sudah dibuat TIDAK BISA diubah atau dihapus
    // kecuali oleh admin (untuk koreksi darurat).
    // ────────────────────────────────────────────────────────────────────────
    match /stockTransactions/{txId} {
      allow read:   if isAnyStaff();

      // Siapapun yang berhak (gudang atau produksi) bisa buat transaksi baru,
      // asal mencantumkan uid sendiri sebagai pelaku
      allow create: if isGudang() || isProduksi()
                    && request.resource.data.dilakukanOleh == request.auth.uid;

      // Tidak ada yang boleh edit transaksi yang sudah ada (immutable log)
      allow update: if false;

      // Hanya admin yang bisa hapus (kasus koreksi ekstrem)
      allow delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────────
    // GOODS RECEIPTS (penerimaan bahan dari supplier)
    // ────────────────────────────────────────────────────────────────────────
    match /goodsReceipts/{receiptId} {
      allow read:   if isAnyStaff();
      allow create: if isGudang()
                    && request.resource.data.diterimaOleh == request.auth.uid;
      allow update: if isGudang() || isManajer();
      allow delete: if isAdmin();

      // Detail item dalam penerimaan
      match /items/{itemId} {
        allow read:           if isAnyStaff();
        allow create, update: if isGudang();
        allow delete:         if isAdmin();
      }
    }

    // ────────────────────────────────────────────────────────────────────────
    // WAREHOUSE TRANSFERS (transfer produk Gudang Besar -> Gudang Packing)
    // ────────────────────────────────────────────────────────────────────────
    match /warehouseTransfers/{id} {
      allow read:   if isAnyStaff();
      allow create: if isAnyStaff();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────────
    // PRODUCT OUTFLOWS (pengeluaran produk jadi Gudang Packing)
    // ────────────────────────────────────────────────────────────────────────
    match /productOutflows/{id} {
      allow read:   if isAnyStaff();
      allow create: if isAnyStaff();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ────────────────────────────────────────────────────────────────────────
    // TOLAK SEMUA AKSES LAIN (default deny)
    // ────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
