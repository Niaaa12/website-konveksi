// firestore.rules
// Deploy dengan: firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isManajer() {
      return isSignedIn() && getUserRole() in ['admin', 'manajer'];
    }

    function isProduksi() {
      return isSignedIn() && getUserRole() in ['admin', 'manajer', 'produksi'];
    }

    function isGudang() {
      return isSignedIn() && getUserRole() in ['admin', 'manajer', 'gudang'];
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Collection: users ───────────────────────────────────────────────────
    match /users/{uid} {
      // User hanya bisa baca profilnya sendiri; admin bisa baca semua
      allow read:   if isOwner(uid) || isAdmin();
      // Hanya admin yang bisa buat/hapus user
      allow create, delete: if isAdmin();
      // User bisa update profilnya sendiri (terbatas); admin bisa update semua
      allow update: if isOwner(uid) || isAdmin();
    }

    // ── Collection: workOrders ──────────────────────────────────────────────
    match /workOrders/{docId} {
      allow read:   if isSignedIn();
      allow create: if isProduksi();
      allow update: if isProduksi();
      allow delete: if isAdmin();
    }

    // ── Collection: bahanBaku ───────────────────────────────────────────────
    match /bahanBaku/{docId} {
      allow read:   if isSignedIn();
      allow create: if isGudang();
      allow update: if isGudang();
      allow delete: if isAdmin();
    }

    // ── Collection: transaksiPersediaan ─────────────────────────────────────
    match /transaksiPersediaan/{docId} {
      allow read:   if isSignedIn();
      allow create: if isGudang() || isProduksi();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Collection: pesanan ─────────────────────────────────────────────────
    match /pesanan/{docId} {
      allow read:   if isSignedIn();
      allow create: if isManajer();
      allow update: if isManajer() || isProduksi();
      allow delete: if isAdmin();
    }

    // ── Collection: katalogProduk ───────────────────────────────────────────
    match /katalogProduk/{docId} {
      allow read:   if isSignedIn();
      allow write:  if isAdmin() || isManajer();
    }

    // ── Tolak semua akses lain secara default ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
